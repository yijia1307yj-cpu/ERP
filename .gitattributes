# 统一换行，避免 Windows/Mac 互相污染
* text=auto eol=lf

*.sh        text eol=lf
*.bat       text eol=crlf
*.cmd       text eol=crlf

# 二进制文件（避免 diff 乱码）
*.png       binary
*.jpg       binary
*.jpeg      binary
*.webp      binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.xmind     binary
*.xlsx      binary
*.zip       binary
*.woff      binary
*.woff2     binary

# 大文件走 LFS（可选，按需开启）
# *.psd     filter=lfs diff=lfs merge=lfs -text
# *.mp4     filter=lfs diff=lfs merge=lfs -text

# 语言统计：排除生成物
dist/**     linguist-generated=true
pnpm-lock.yaml linguist-generated=true
